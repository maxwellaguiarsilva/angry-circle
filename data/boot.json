  "scoring": {
    "hit": 10,
    "knockdown": 25,
    "destroy": 25,
    "launch-bonus": 50
  },
  "hud": {
    "x": 24,
    "y": 28,
    "font": "600 18px monospace",
    "fill": "#ffffff",
    "label": "Score"
  },
  "game-over": {
    "won-text": "You cleared the level!",
    "lost-text": "Out of launches!",
    "restart-text": "Tap to play again",
    "font": "700 30px monospace",
    "fill": "#ffffff",
    "restart-font": "400 15px monospace",
