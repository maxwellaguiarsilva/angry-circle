{
  "canvas": {
    "width": 800,
    "height": 600,
    "background": "#1a1a2e"
  },
  "launcher": {
    "x": 120,
    "y": 520
  },
  "timing": {
    "timestep": 0.016666666666666666,
    "max-frame-time": 0.25
  },
  "physics": {
    "gravity": 980,
    "restitution": 0.6,
    "density": 0.01,
    "solver-iterations": 4
  },
  "slingshot": {
    "max-drag": 150,
    "max-power": 1200,
    "power-curve": { "type": "power", "exponent": 2 }
  },
  "slingshot-visual": {
    "band-color": "#ffffff",
    "band-width": 4,
    "frame-color": "#8d6e63",
    "frame-width": 8,
    "frame-base-offset-y": 80,
    "frame-split-offset-y": 12,
    "tine-offset-x": 30,
    "tine-offset-y": 40,
    "pouch-color": "#6b4f3a",
    "pouch-radius": 12
